# No real credentials. Keep actual files outside Git; never use NEXT_PUBLIC_*.
# Absolute writable persistent path, outside crmbackup components:
BACKUP_SETTINGS_DIR=
# Server only: generate 32 cryptographically random bytes, base64 encode; save independently.
# Never ship a sample key or reuse the recovery key.
BACKUP_SETTINGS_MASTER_KEY=
# Desktop uses DPAPI CurrentUser instead of the server master key.
# Desktop runtime must already set CRM_DEPLOYMENT_MODE=desktop and LOCALAPPDATA.
