# ─────────────────────────────────────────────────────────────────────────────
# Шаблон конфигурации CRM (ТЗ 36.5). Скопируйте в .env через scripts/bootstrap.sh —
# он сгенерирует секреты и идентификаторы. Файл .env в Git не коммитится.
# Пустые секретные значения ниже заполняет bootstrap; небезопасных defaults нет.
# ─────────────────────────────────────────────────────────────────────────────

# Сеть и приложение
# порт, публикуемый в офисную сеть
APP_PORT=8080
# 127.0.0.1 — только локально (portable)
APP_BIND=0.0.0.0
NODE_ENV=production
# подтверждается перед пилотом (ТЗ 40.11)
APP_TIMEZONE=Europe/Moscow
LOG_LEVEL=info

# Идентичность развёртывания (ТЗ 41.4)
# server | portable
DEPLOYMENT_MODE=server
# UUID набора рабочих данных — генерирует bootstrap
DEPLOYMENT_ID=
# идентификатор конкретной установки — генерирует bootstrap
INSTANCE_ID=
# active | standby (standby — только чтение)
INSTANCE_ROLE=active

# PostgreSQL 18 (контейнер db, наружу не публикуется)
POSTGRES_DB=crm
POSTGRES_USER=crm
# генерирует bootstrap
POSTGRES_PASSWORD=
# Строка подключения собирается compose из параметров выше; для справки:
DATABASE_URL=postgresql://crm:<POSTGRES_PASSWORD>@db:5432/crm

# Сессии и безопасность
SESSION_TTL_HOURS=12
# auto | true | false (true — при работе через HTTPS)
COOKIE_SECURE=auto
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# Файлы (каталоги на хосте: ./data/files, ./data/import-staging, ./backups)
FILE_STORAGE_PATH=/data/files
IMPORT_STAGING_PATH=/data/import-staging
BACKUP_PATH=/backups
MAX_UPLOAD_MB=50
UPLOAD_ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,webp,doc,docx,xls,xlsx,txt,csv

# Бизнес-параметры отчётности и контроля
# повторная активация клиента (ТЗ 31.5)
REACTIVATION_GAP_DAYS=90
# «заявки без движения» (ТЗ 40.6)
NEED_INACTIVITY_DAYS=14
AGREEMENT_EXPIRY_WARNING_DAYS=30
AD_CHECK_INTERVAL_DAYS=7

# Резервное копирование
# число хранимых ежедневных локальных копий
BACKUP_RETENTION_DAILY=14
# off-site targets через запятую, например: nas-main,yandex-main (настройка: scripts/backup-remote-add.sh)
BACKUP_TARGETS=
# targets, без verified-реплики в которых backup дня считается неполным
BACKUP_MANDATORY_TARGETS=
BACKUP_REMOTE_RETENTION_DAILY=14
# каталог (например, смонтированный NAS) для target типа filesystem
BACKUP_FILESYSTEM_TARGET_PATH=./data/offsite-local
# rclone.conf и crypt-пароли; не коммитится, хранится отдельно
BACKUP_SECRETS_DIR=./secrets
# пароль шифрования rclone.conf (если используется)
RCLONE_CONFIG_PASS=

# AI-контур (P3, опционально) — по умолчанию выключен
AI_ENABLED=false

# Первичные учётные записи (seed): пароли генерирует bootstrap,
# при первом входе требуется смена пароля.
SEED_MANAGER_LOGIN=manager
SEED_REALTOR1_LOGIN=realtor1
SEED_REALTOR2_LOGIN=realtor2
SEED_MANAGER_PASSWORD=
SEED_REALTOR1_PASSWORD=
SEED_REALTOR2_PASSWORD=
SEED_MUST_CHANGE_PASSWORD=true
# true — синтетические демо-данные для показа/обучения
SEED_DEMO_DATA=false

# uid/gid, от которых работают контейнеры (владелец data/ и backups/) — задаёт bootstrap
APP_UID=1000
APP_GID=1000

# Версия образа (заполняется scripts/deploy.sh из git)
APP_VERSION=1.0.0
APP_COMMIT=unknown
