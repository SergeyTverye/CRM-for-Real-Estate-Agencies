{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 2
    },
    "code": {
      "type": "string",
      "const": "enterprise_workbook_v2"
    },
    "sheets": {
      "minItems": 1,
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "namePattern": {
            "type": "string",
            "maxLength": 120
          },
          "target": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "property",
                  "client_request_need",
                  "historical_deal_archive",
                  "property_agreement_control",
                  "ignore"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "blockTargets": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "property",
                    "client_request_need",
                    "historical_deal_archive",
                    "property_agreement_control",
                    "ignore"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "headerRow": {
            "default": "auto",
            "anyOf": [
              {
                "type": "string",
                "const": "auto"
              },
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            ]
          },
          "columns": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "addressText",
                    "district",
                    "area",
                    "floor",
                    "propertyTypeText",
                    "operationText",
                    "price",
                    "priceUnit",
                    "description",
                    "stateMark",
                    "ownerName",
                    "ownerPhone",
                    "receivedDate",
                    "name",
                    "phone",
                    "email",
                    "request",
                    "source",
                    "responsible",
                    "comment",
                    "sourceRowId",
                    "contractRef",
                    "commissionAmount",
                    "agreementPresence",
                    "absenceReason",
                    "commissionFrom",
                    "commissionTo",
                    "fixNote",
                    "adText",
                    "adUrl",
                    "taskText"
                  ]
                },
                {
                  "type": "string",
                  "const": "ignore"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "hiddenRows": {
            "default": "skip",
            "type": "string",
            "enum": [
              "skip",
              "archive"
            ]
          },
          "statusMap": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string",
              "enum": [
                "draft",
                "active",
                "paused",
                "closed",
                "archived"
              ]
            }
          },
          "purposeMap": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "sourceMap": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "responsibleMap": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "defaults": {
            "default": {
              "propertyType": "commercial"
            },
            "type": "object",
            "properties": {
              "propertyType": {
                "default": "commercial",
                "type": "string",
                "enum": [
                  "commercial",
                  "residential",
                  "land",
                  "country"
                ]
              },
              "operationType": {
                "type": "string",
                "enum": [
                  "rent",
                  "sale"
                ]
              },
              "district": {
                "type": "string"
              },
              "priceUnit": {
                "type": "string",
                "enum": [
                  "rub_total",
                  "rub_month",
                  "rub_m2",
                  "rub_m2_month",
                  "rub_year",
                  "rub_m2_year"
                ]
              }
            },
            "required": [
              "propertyType"
            ],
            "additionalProperties": false
          },
          "sections": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "pattern": {
                  "type": "string",
                  "maxLength": 120
                },
                "propertyType": {
                  "type": "string",
                  "enum": [
                    "commercial",
                    "residential",
                    "land",
                    "country"
                  ]
                },
                "operationType": {
                  "type": "string",
                  "enum": [
                    "rent",
                    "sale"
                  ]
                },
                "district": {
                  "type": "string"
                }
              },
              "required": [
                "pattern"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "target",
          "headerRow",
          "columns",
          "hiddenRows",
          "statusMap",
          "purposeMap",
          "sourceMap",
          "responsibleMap",
          "defaults",
          "sections"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "code",
    "sheets"
  ],
  "additionalProperties": false
}
