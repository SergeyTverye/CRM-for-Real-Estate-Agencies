{
  "name": "crm-real-estate",
  "version": "1.0.0",
  "private": true,
  "description": "CRM-система для ООО «Магазин недвижимости» (ТЗ v1.6.1)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "security:guard": "node scripts/security/confidential-guard.mjs",
    "dev": "next dev",
    "build": "prisma generate && npm run desktop:generate && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "prisma generate && npm run desktop:generate && tsc --noEmit",
    "test": "vitest run --project unit --project browser-cycle",
    "test:integration": "vitest run --project integration --project authorization",
    "test:all": "vitest run",
    "test:e2e": "playwright test",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:seed:demo": "tsx scripts/demo/seed-demo.ts",
    "db:migrate:dev": "prisma migrate dev",
    "import:sample": "tsx scripts/dev/generate-import-sample.ts",
    "dev:webpack": "next dev --webpack",
    "test:e2e:full": "npm run build && playwright test",
    "desktop:schema": "tsx scripts/desktop/gen-sqlite-schema.ts",
    "desktop:generate": "npm run desktop:schema && prisma generate --config prisma/sqlite.config.ts",
    "desktop:migration:baseline": "tsx scripts/desktop/gen-sqlite-migration.ts",
    "desktop:migrate": "tsx scripts/desktop/migrate-sqlite.ts",
    "test:integration:sqlite": "vitest run --project integration-sqlite",
    "desktop:audit": "tsx scripts/desktop/sqlite-audit.ts",
    "desktop:smoke:migrate": "tsx scripts/desktop/smoke-migrate.ts",
    "desktop:bundle": "node scripts/desktop/build-desktop-bundle.mjs",
    "desktop:tauri": "tauri build --bundles nsis",
    "desktop:init": "tsx scripts/desktop/init-db.ts --initialize",
    "desktop:transfer": "tsx scripts/desktop/migrate-pg-to-sqlite.ts",
    "desktop:upgrade-db": "tsx scripts/desktop/upgrade-db.ts",
    "test:desktop:transfer": "vitest run --project desktop-transfer"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1163.0",
    "@fullcalendar/core": "6.1.22",
    "@fullcalendar/daygrid": "6.1.22",
    "@fullcalendar/interaction": "6.1.22",
    "@fullcalendar/list": "6.1.22",
    "@fullcalendar/react": "6.1.22",
    "@fullcalendar/timegrid": "6.1.22",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@xmldom/xmldom": "0.9.12",
    "better-sqlite3": "12.6.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "docx": "9.15.1",
    "dotenv": "18.0.9",
    "exceljs": "4.4.0",
    "fflate": "0.8.3",
    "lucide-react": "1.68.0",
    "next": "16.4.4",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "prisma": "7.10.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "real-estate-scrapper": "file:vendor/real-estate-scrapper-2.1.0.tgz",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "tsx": "4.23.15",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@tauri-apps/cli": "2.12.4",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.4",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "webdav-server": "2.6.3"
  },
  "allowScripts": {
    "better-sqlite3@12.6.2": true
  }
}
