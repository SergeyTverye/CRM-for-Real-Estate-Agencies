{
  "name": "crm-real-estate",
  "version": "1.0.0",
  "private": true,
  "description": "CRM-система для ООО «Магазин недвижимости» (ТЗ v1.6.1)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration --project authorization",
    "test:all": "vitest run",
    "test:e2e": "playwright test",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:seed:demo": "tsx scripts/demo/seed-demo.ts",
    "db:migrate:dev": "prisma migrate dev",
    "import:sample": "tsx scripts/dev/generate-import-sample.ts",
    "dev:webpack": "next dev --webpack",
    "test:e2e:full": "npm run build && playwright test"
  },
  "dependencies": {
    "@fullcalendar/core": "6.1.22",
    "@fullcalendar/daygrid": "6.1.22",
    "@fullcalendar/interaction": "6.1.22",
    "@fullcalendar/list": "6.1.22",
    "@fullcalendar/react": "6.1.22",
    "@fullcalendar/timegrid": "6.1.22",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "docx": "9.15.1",
    "dotenv": "18.0.9",
    "exceljs": "4.4.0",
    "fflate": "0.8.3",
    "lucide-react": "1.68.0",
    "next": "16.4.4",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "prisma": "7.10.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "real-estate-scrapper": "file:vendor/real-estate-scrapper-2.1.0.tgz",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.4",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
