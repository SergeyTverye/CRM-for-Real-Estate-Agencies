{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RealEstateCRM",
  "version": "3.2.1",
  "identifier": "ru.realestate.crm",
  "mainBinaryName": "RealEstateCRM",
  "build": {
    "frontendDist": "frontend",
    "windows": {
      "staticVCRuntime": true
    }
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'none'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "RealEstateCRM",
    "shortDescription": "Автономная CRM агентства недвижимости",
    "resources": {
      "resources/app/": "app/",
      "windows/uninstall-cleanup.ps1": "uninstall-cleanup.ps1"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian"
        ],
        "displayLanguageSelector": false,
        "startMenuFolder": "RealEstateCRM",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "icon": [
      "icons/icon.ico"
    ]
  }
}
