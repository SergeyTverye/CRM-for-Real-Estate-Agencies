// Prisma schema — исполняемая реализация раздела 29 ТЗ v1.6.1.
// Имена таблиц/колонок — snake_case, PK — UUID, моменты времени — timestamptz(3)
// (миллисекундная точность совпадает с JS Date и нужна для optimistic concurrency
// по updated_at), денежные поля — numeric(16,2).
// CHECK-ограничения и partial unique indexes, которые Prisma DSL не выражает,
// добавлены SQL-фрагментами в миграции (см. docs/data-model-mapping.md).
// Ни одна связь не использует ON DELETE CASCADE: значимая история не удаляется.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Идентификация и доступ ─────────────────────────────

model User {
  browserSessions          InteractiveBrowserSession[]
  duplicateDecisions       ListingDuplicateDecision[]
  taskChecklistResponsible TaskChecklistItem[]         @relation("TaskChecklistResponsible")
  taskChecklistCompleted   TaskChecklistItem[]         @relation("TaskChecklistCompleted")
  plannerSettings          PlannerSetting[]
  bulkTaskBatches          BulkTaskBatch[]
  propertyCollections      PropertyCollection[]
  collectionItemsAdded     PropertyCollectionItem[]
  collectionNeedsLinked    PropertyCollectionNeed[]
  templateVersions         DocumentTemplateVersion[]
  aiChatSessions           AiChatSession[]
  aiActionDecisions        AiPendingAction[]
  searchExports            SearchExport[]

  searchBookmarks        SearchBookmark[]
  searchSelections       SearchSelection[]
  savedSearches          SavedSearch[]
  searchRuns             SearchRun[]
  listingVerifications   ExternalListingVerification[]
  aiSettings             AiSetting[]
  aiUsageLogs            AiUsageLog[]
  calendarEvents         CalendarEvent[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  checklistItems         DealChecklistItem[]
  id                     String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  login                  String                        @unique
  displayName            String                        @map("display_name")
  roleCode               String                        @map("role_code")
  passwordHash           String                        @map("password_hash")
  mustChangePassword     Boolean                       @default(false) @map("must_change_password")
  passwordChangedAt      DateTime?                     @map("password_changed_at") @db.Timestamptz(3)
  isActive               Boolean                       @default(true) @map("is_active")
  createdAt              DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions                  UserSession[]
  grantsReceived            PropertyContactGrant[] @relation("GrantUser")
  grantsIssued              PropertyContactGrant[] @relation("GrantIssuer")
  clientsResponsible        Client[]               @relation("ClientResponsible")
  clientsCreated            Client[]               @relation("ClientCreatedBy")
  leadRequestsResponsible   LeadRequest[]          @relation("LeadResponsible")
  leadRequestsCreated       LeadRequest[]          @relation("LeadCreatedBy")
  needsResponsible          ClientNeed[]           @relation("NeedResponsible")
  needsCreated              ClientNeed[]           @relation("NeedCreatedBy")
  stageChanges              NeedStageHistory[]
  propertiesResponsible     Property[]             @relation("PropertyResponsible")
  propertiesCreated         Property[]             @relation("PropertyCreatedBy")
  matchesCreated            NeedPropertyMatch[]
  showingsResponsible       Showing[]              @relation("ShowingResponsible")
  showingsCreated           Showing[]              @relation("ShowingCreatedBy")
  advertisementsResponsible Advertisement[]
  agreementsResponsible     Agreement[]
  communications            Communication[]
  tasksResponsible          Task[]                 @relation("TaskResponsible")
  tasksCreated              Task[]                 @relation("TaskCreatedBy")
  dealsResponsible          Deal[]                 @relation("DealResponsible")
  dealsCreated              Deal[]                 @relation("DealCreatedBy")
  offersResponsible         CommercialOffer[]      @relation("OfferResponsible")
  offersCreated             CommercialOffer[]      @relation("OfferCreatedBy")
  documentsUploaded         Document[]
  importJobs                ImportJob[]
  backupRuns                BackupRun[]
  auditEntries              AuditLog[]
  aiRuns                    AiRun[]

  @@map("users")
}

model UserSession {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  userAgent  String?   @map("user_agent")
  ipAddress  String?   @map("ip_address")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@map("user_sessions")
}

model PropertyContactGrant {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId String    @map("property_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  grantedBy  String    @map("granted_by") @db.Uuid
  grantedAt  DateTime  @default(now()) @map("granted_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  comment    String?

  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  user     User     @relation("GrantUser", fields: [userId], references: [id], onDelete: Restrict)
  issuer   User     @relation("GrantIssuer", fields: [grantedBy], references: [id], onDelete: Restrict)

  // partial UNIQUE(property_id, user_id) WHERE revoked_at IS NULL — в SQL миграции
  @@index([propertyId])
  @@index([userId])
  @@index([grantedBy])
  @@map("property_contact_grants")
}

// ───────────────────────────── Клиенты и обращения ─────────────────────────────

model Client {
  calendarEvents    CalendarEvent[]
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  displayName       String          @map("display_name")
  clientKind        String          @map("client_kind")
  responsibleUserId String          @map("responsible_user_id") @db.Uuid
  status            String
  notes             String?
  archivedAt        DateTime?       @map("archived_at") @db.Timestamptz(3)
  createdBy         String          @map("created_by") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  responsible    User                    @relation("ClientResponsible", fields: [responsibleUserId], references: [id], onDelete: Restrict)
  creator        User                    @relation("ClientCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  contactPersons ClientContactPerson[]
  contacts       ClientContact[]
  needs          ClientNeed[]
  leadRequests   LeadRequest[]
  communications Communication[]
  ownerships     PropertyOwner[]
  agreements     Agreement[]
  dealParties    DealParty[]
  archiveRecords HistoricalDealArchive[]
  taskLinks      TaskClient[]
  documentLinks  DocumentClient[]

  @@index([responsibleUserId])
  @@index([createdBy])
  @@index([status])
  @@index([displayName])
  @@map("clients")
}

model ClientContactPerson {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  fullName  String   @map("full_name")
  position  String?
  isPrimary Boolean  @default(false) @map("is_primary")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  client   Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  contacts ClientContact[]

  @@index([clientId])
  @@map("client_contact_persons")
}

model ClientContact {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId        String   @map("client_id") @db.Uuid
  contactType     String   @map("contact_type")
  rawValue        String   @map("raw_value")
  normalizedValue String?  @map("normalized_value")
  contactPersonId String?  @map("contact_person_id") @db.Uuid
  isPrimary       Boolean  @default(false) @map("is_primary")
  comment         String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  client        Client               @relation(fields: [clientId], references: [id], onDelete: Restrict)
  contactPerson ClientContactPerson? @relation(fields: [contactPersonId], references: [id], onDelete: Restrict)

  // partial UNIQUE(client_id, contact_type, normalized_value) WHERE normalized_value IS NOT NULL — в SQL
  @@index([clientId])
  @@index([normalizedValue])
  @@index([contactPersonId])
  @@map("client_contacts")
}

model LeadRequest {
  callAt            DateTime?        @map("call_at") @db.Timestamptz(3)
  externalListingId String?          @map("external_listing_id") @db.Uuid
  outcomeCode       String?          @map("outcome_code")
  externalListing   ExternalListing? @relation(fields: [externalListingId], references: [id], onDelete: Restrict)

  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId          String?  @map("client_id") @db.Uuid
  clientNeedId      String?  @map("client_need_id") @db.Uuid
  propertyId        String?  @map("property_id") @db.Uuid
  advertisementId   String?  @map("advertisement_id") @db.Uuid
  responsibleUserId String   @map("responsible_user_id") @db.Uuid
  occurredAt        DateTime @map("occurred_at") @db.Timestamptz(3)
  channelCode       String   @map("channel_code")
  sourceCode        String   @map("source_code")
  resultCode        String   @map("result_code")
  statusCode        String   @map("status_code")
  summary           String?
  rawContact        String?  @map("raw_contact")
  createdBy         String   @map("created_by") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  client         Client?         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  need           ClientNeed?     @relation(fields: [clientNeedId], references: [id], onDelete: Restrict)
  property       Property?       @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  advertisement  Advertisement?  @relation(fields: [advertisementId], references: [id], onDelete: Restrict)
  responsible    User            @relation("LeadResponsible", fields: [responsibleUserId], references: [id], onDelete: Restrict)
  creator        User            @relation("LeadCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  communications Communication[]

  @@index([externalListingId])
  @@index([callAt, responsibleUserId])
  @@index([outcomeCode, occurredAt])
  @@index([responsibleUserId, occurredAt])
  @@index([sourceCode, occurredAt])
  @@index([statusCode])
  @@index([clientId])
  @@index([clientNeedId])
  @@index([propertyId])
  @@index([advertisementId])
  @@index([createdBy])
  @@map("lead_requests")
}

model ClientNeed {
  collectionLinks PropertyCollectionNeed[]

  calendarEvents     CalendarEvent[]
  searchSelections   SearchSelection[]
  savedSearches      SavedSearch[]
  searchRuns         SearchRun[]
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId           String            @map("client_id") @db.Uuid
  responsibleUserId  String            @map("responsible_user_id") @db.Uuid
  operationType      String            @map("operation_type")
  propertyType       String            @map("property_type")
  propertySubtype    String?           @map("property_subtype")
  financingType      String?           @map("financing_type")
  mortgageStatus     String?           @map("mortgage_status")
  budgetMin          Decimal?          @map("budget_min") @db.Decimal(16, 2)
  budgetMax          Decimal?          @map("budget_max") @db.Decimal(16, 2)
  district           String?
  locationText       String?           @map("location_text")
  areaMin            Decimal?          @map("area_min") @db.Decimal(12, 2)
  areaMax            Decimal?          @map("area_max") @db.Decimal(12, 2)
  commercialPurpose  String?           @map("commercial_purpose")
  floorMin           Int?              @map("floor_min")
  floorMax           Int?              @map("floor_max")
  roomsMin           Int?              @map("rooms_min")
  roomsMax           Int?              @map("rooms_max")
  landAreaMin        Decimal?          @map("land_area_min") @db.Decimal(12, 2)
  landAreaMax        Decimal?          @map("land_area_max") @db.Decimal(12, 2)
  buildingAreaMin    Decimal?          @map("building_area_min") @db.Decimal(12, 2)
  buildingAreaMax    Decimal?          @map("building_area_max") @db.Decimal(12, 2)
  powerRequirement   Decimal?          @map("power_requirement") @db.Decimal(10, 2)
  parkingRequirement Boolean?          @map("parking_requirement")
  tenantRequirement  Boolean?          @map("tenant_requirement")
  stage              String
  status             String
  stopReasonCode     String?           @map("stop_reason_code")
  stopComment        String?           @map("stop_comment")
  notes              String?
  openedAt           DateTime          @default(now()) @map("opened_at") @db.Timestamptz(3)
  closedAt           DateTime?         @map("closed_at") @db.Timestamptz(3)
  createdBy          String            @map("created_by") @db.Uuid
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  client           Client              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  responsible      User                @relation("NeedResponsible", fields: [responsibleUserId], references: [id], onDelete: Restrict)
  creator          User                @relation("NeedCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  leadRequests     LeadRequest[]
  stageHistory     NeedStageHistory[]
  matches          NeedPropertyMatch[]
  showings         Showing[]
  communications   Communication[]
  commercialOffers CommercialOffer[]
  taskLinks        TaskNeed[]
  documentLinks    DocumentNeed[]

  @@index([clientId])
  @@index([responsibleUserId, status])
  @@index([createdBy])
  @@map("client_needs")
}

model NeedStageHistory {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientNeedId String   @map("client_need_id") @db.Uuid
  fromStage    String?  @map("from_stage")
  toStage      String   @map("to_stage")
  fromStatus   String?  @map("from_status")
  toStatus     String?  @map("to_status")
  reasonCode   String?  @map("reason_code")
  comment      String?
  changedBy    String   @map("changed_by") @db.Uuid
  occurredAt   DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  need    ClientNeed @relation(fields: [clientNeedId], references: [id], onDelete: Restrict)
  changer User       @relation(fields: [changedBy], references: [id], onDelete: Restrict)

  @@index([clientNeedId, occurredAt])
  @@index([changedBy])
  @@map("need_stage_history")
}

model Communication {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId          String   @map("client_id") @db.Uuid
  clientNeedId      String?  @map("client_need_id") @db.Uuid
  leadRequestId     String?  @map("lead_request_id") @db.Uuid
  authorUserId      String   @map("author_user_id") @db.Uuid
  communicationType String   @map("communication_type")
  channelCode       String?  @map("channel_code")
  occurredAt        DateTime @map("occurred_at") @db.Timestamptz(3)
  resultCode        String?  @map("result_code")
  comment           String?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  client      Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  need        ClientNeed?  @relation(fields: [clientNeedId], references: [id], onDelete: Restrict)
  leadRequest LeadRequest? @relation(fields: [leadRequestId], references: [id], onDelete: Restrict)
  author      User         @relation(fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([clientId, occurredAt])
  @@index([clientNeedId])
  @@index([leadRequestId])
  @@index([authorUserId])
  @@map("communications")
}

// ───────────────────────────── Объекты и работа с рынком ─────────────────────────────

model Property {
  collectionItems PropertyCollectionItem[]

  externalListings   ExternalListing[]
  searchSelections   SearchSelection[]
  calendarEvents     CalendarEvent[]
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  responsibleUserId  String?           @map("responsible_user_id") @db.Uuid
  propertyType       String            @map("property_type")
  propertySubtype    String?           @map("property_subtype")
  operationType      String            @map("operation_type")
  sourceType         String            @map("source_type")
  sourcePlatformCode String?           @map("source_platform_code")
  sourceUrl          String?           @map("source_url")
  addressText        String            @map("address_text")
  district           String?
  area               Decimal?          @db.Decimal(12, 2)
  floor              Int?
  floorsTotal        Int?              @map("floors_total")
  roomsCount         Int?              @map("rooms_count")
  landArea           Decimal?          @map("land_area") @db.Decimal(12, 2)
  buildingArea       Decimal?          @map("building_area") @db.Decimal(12, 2)
  price              Decimal?          @db.Decimal(16, 2)
  commercialPurpose  String?           @map("commercial_purpose")
  powerKw            Decimal?          @map("power_kw") @db.Decimal(10, 2)
  parkingAvailable   Boolean?          @map("parking_available")
  hasTenant          Boolean?          @map("has_tenant")
  status             String
  description        String?
  attributesJsonb    Json?             @map("attributes_jsonb")
  archivedAt         DateTime?         @map("archived_at") @db.Timestamptz(3)
  createdBy          String            @map("created_by") @db.Uuid
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  responsible    User?                  @relation("PropertyResponsible", fields: [responsibleUserId], references: [id], onDelete: Restrict)
  creator        User                   @relation("PropertyCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  owners         PropertyOwner[]
  contactGrants  PropertyContactGrant[]
  matches        NeedPropertyMatch[]
  showings       Showing[]
  advertisements Advertisement[]
  agreements     Agreement[]
  leadRequests   LeadRequest[]
  deals          Deal[]
  offerItems     CommercialOfferItem[]
  taskLinks      TaskProperty[]
  documentLinks  DocumentProperty[]

  @@index([status, district, propertyType, operationType])
  @@index([responsibleUserId])
  @@index([createdBy])
  @@index([addressText])
  @@map("properties")
}

model PropertyOwner {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId     String   @map("property_id") @db.Uuid
  clientId       String   @map("client_id") @db.Uuid
  ownerRole      String?  @map("owner_role")
  ownershipShare Decimal? @map("ownership_share") @db.Decimal(7, 4)
  comment        String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@unique([propertyId, clientId])
  @@index([clientId])
  @@map("property_owners")
}

model NeedPropertyMatch {
  searchSelections    SearchSelection[]
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientNeedId        String            @map("client_need_id") @db.Uuid
  propertyId          String            @map("property_id") @db.Uuid
  offeredAt           DateTime          @default(now()) @map("offered_at") @db.Timestamptz(3)
  sourceCode          String?           @map("source_code")
  status              String
  rejectionReasonCode String?           @map("rejection_reason_code")
  comment             String?
  createdBy           String            @map("created_by") @db.Uuid
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  need     ClientNeed @relation(fields: [clientNeedId], references: [id], onDelete: Restrict)
  property Property   @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  creator  User       @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([clientNeedId, offeredAt])
  @@index([propertyId])
  @@index([createdBy])
  @@map("need_property_matches")
}

model Showing {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientNeedId      String    @map("client_need_id") @db.Uuid
  propertyId        String    @map("property_id") @db.Uuid
  responsibleUserId String    @map("responsible_user_id") @db.Uuid
  scheduledAt       DateTime  @map("scheduled_at") @db.Timestamptz(3)
  occurredAt        DateTime? @map("occurred_at") @db.Timestamptz(3)
  status            String
  resultCode        String?   @map("result_code")
  comment           String?
  participantsText  String?   @map("participants_text")
  createdBy         String    @map("created_by") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  need          ClientNeed        @relation(fields: [clientNeedId], references: [id], onDelete: Restrict)
  property      Property          @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  responsible   User              @relation("ShowingResponsible", fields: [responsibleUserId], references: [id], onDelete: Restrict)
  creator       User              @relation("ShowingCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  taskLinks     TaskShowing[]
  documentLinks DocumentShowing[]

  @@index([clientNeedId])
  @@index([propertyId])
  @@index([responsibleUserId, scheduledAt])
  @@index([createdBy])
  @@map("showings")
}

model Advertisement {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId        String    @map("property_id") @db.Uuid
  responsibleUserId String?   @map("responsible_user_id") @db.Uuid
  platformCode      String    @map("platform_code")
  url               String?
  adText            String?   @map("ad_text")
  status            String
  publishedAt       DateTime? @map("published_at") @db.Timestamptz(3)
  lastCheckedAt     DateTime? @map("last_checked_at") @db.Timestamptz(3)
  expiresAt         DateTime? @map("expires_at") @db.Date
  comment           String?
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  property      Property                @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  responsible   User?                   @relation(fields: [responsibleUserId], references: [id], onDelete: Restrict)
  leadRequests  LeadRequest[]
  taskLinks     TaskAdvertisement[]
  documentLinks DocumentAdvertisement[]

  @@index([status, expiresAt])
  @@index([responsibleUserId])
  @@index([propertyId])
  @@map("advertisements")
}

model Agreement {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId          String?   @map("client_id") @db.Uuid
  propertyId        String?   @map("property_id") @db.Uuid
  dealId            String?   @map("deal_id") @db.Uuid
  responsibleUserId String    @map("responsible_user_id") @db.Uuid
  legalEntityId     String?   @map("legal_entity_id") @db.Uuid
  agreementType     String    @map("agreement_type")
  status            String
  agreementNumber   String?   @map("agreement_number")
  isExclusive       Boolean?  @map("is_exclusive")
  signedAt          DateTime? @map("signed_at") @db.Date
  validFrom         DateTime? @map("valid_from") @db.Date
  validUntil        DateTime? @map("valid_until") @db.Date
  commissionType    String?   @map("commission_type")
  commissionValue   Decimal?  @map("commission_value") @db.Decimal(16, 2)
  commissionNotes   String?   @map("commission_notes")
  absenceReasonCode String?   @map("absence_reason_code")
  actionRequired    String?   @map("action_required")
  notes             String?
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt        DateTime? @map("archived_at") @db.Timestamptz(3)

  client        Client?             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  property      Property?           @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  deal          Deal?               @relation(fields: [dealId], references: [id], onDelete: Restrict)
  responsible   User                @relation(fields: [responsibleUserId], references: [id], onDelete: Restrict)
