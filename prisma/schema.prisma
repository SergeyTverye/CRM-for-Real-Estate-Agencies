  requestedByUserId     String    @map("requested_by_user_id") @db.Uuid
  targetEntityType      String?   @map("target_entity_type")
  targetEntityId        String?   @map("target_entity_id") @db.Uuid
  promptTemplateVersion String    @map("prompt_template_version")
  status                String
  startedAt             DateTime? @map("started_at") @db.Timestamptz(3)
  finishedAt            DateTime? @map("finished_at") @db.Timestamptz(3)
  inputUnits            BigInt?   @map("input_units")
  outputUnits           BigInt?   @map("output_units")
  estimatedCost         Decimal?  @map("estimated_cost") @db.Decimal(16, 4)
  outputDocumentId      String?   @map("output_document_id") @db.Uuid
  errorCode             String?   @map("error_code")
  errorSummary          String?   @map("error_summary")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  requestedBy    User      @relation(fields: [requestedByUserId], references: [id], onDelete: Restrict)
  outputDocument Document? @relation(fields: [outputDocumentId], references: [id], onDelete: Restrict)

  @@index([requestedByUserId, createdAt])
  @@index([featureCode, status, createdAt])
  @@index([outputDocumentId])
  @@map("ai_runs")
}

// Бизнес-справочники (раздел 40.9): каналы, источники, типы объектов/операций,
// рекламные площадки. Стабильный code + русское display_name + признак активности.
// Системный codebook (статусы, от которых зависят инварианты) здесь НЕ хранится —
// он зафиксирован в коде (src/shared/codebook.ts) и CHECK-ограничениях.
model DictionaryItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category    String
  code        String
  displayName String   @map("display_name")
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(100) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([category, code])
  @@map("dictionary_items")
}
